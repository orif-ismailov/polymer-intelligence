# Local design-review runtime for the portal + public API.
# Sourced by the /run helper only; not part of the deploy env contract.
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://pi_user:devpassword@127.0.0.1:5432/polymer_intelligence
REDIS_URL=redis://127.0.0.1:6379/3

JWT_SECRET=local-design-review-jwt-secret-value-32chars-min
VERIFICATION_ENC_KEY=ZqK-JYB7GPQeS2RzYxbsb0NMgT73bqh3XaS4iTIrXUk=

# Placeholders — no outbound call is made on the public routes.
ANTHROPIC_API_KEY=sk-ant-placeholder
BOT_TOKEN=0000000000:placeholder-bot-token
WEBHOOK_SECRET=placeholder-webhook-secret
TG_API_ID=1
TG_API_HASH=placeholder

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=polymer-files

SMS_PROVIDER=console
OTP_DEV_CODE=000000
OTP_MAX_SENDS_PER_DAY=5000
EIMZO_STUB=true

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUN_MIGRATIONS_ON_STARTUP=false
