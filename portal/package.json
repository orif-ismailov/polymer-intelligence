{
  "name": "polymer-intelligence-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=5173 node server.js",
    "build": "tsc -b tsconfig.build.json && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "cross-env SSR_BUILD=1 vite build --ssr src/entry-server.tsx",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && cross-env NODE_ENV=production DEV_API_PROXY=1 node server.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "sirv": "^3.0.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.1",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
