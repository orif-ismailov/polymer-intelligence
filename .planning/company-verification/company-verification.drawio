  <diagram id="flow-page" name="Verification flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="f1" value="Company submits verification case&#10;(wizard: profile, roles, bank, docs, licenses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Auto checks fan out (verify queue)&#10;gov registry, tax, VAT, bank, licenses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="needs_info&#10;(mismatch — user corrects, checks re-run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="unavailable&#10;(provider down — retry w/ backoff, or admin waive, audited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="pending_review&#10;(staff: dashboard queue or Telegram inline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="rejected&#10;(resubmit allowed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#501313;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="740" y="450" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="approved → company.verified&#10;trust init, eligibility compute, publish unlock, bot DM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#173404;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="Re-verification (beat): due date or gov registry drift → new targeted case, silent pass unless drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;dashed=1;fontColor=#444441;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="380" y="580" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" value="mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;fontSize=11" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="provider outage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;fontSize=11" edge="1" parent="1" source="f2" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" value="checks terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;fontSize=11" edge="1" parent="1" source="f2" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" value="resubmit ↻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;dashed=1;fontSize=11" edge="1" parent="1" source="f3" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" value="retry / waive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;dashed=1;fontSize=11" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe7" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A32D2D;fontSize=11;fontColor=#791F1F" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe8" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B6D11;fontSize=11;fontColor=#27500A" edge="1" parent="1" source="f5" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe9" value="all auto passed + auto_approve setting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;dashed=1;fontSize=11;fontColor=#3C3489" edge="1" parent="1" source="f2" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;dashed=1" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
