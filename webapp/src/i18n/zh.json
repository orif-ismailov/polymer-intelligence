      },
      "CIF": {
        "summary": "与 CFR 类似，但您还需投保到目的港的基本货物保险。海运中很常见。"
      },
      "CPT": {
        "summary": "您支付到约定地点的运费，但货物一交给第一承运人，风险即转移给买方。"
      },
      "CIP": {
        "summary": "与 CPT 类似，且您还需投保到目的地的货物保险。适用于任何运输方式。"
