# Polymer Intelligence — DEV-server .env template
# ============================================================================
# This is the DEV environment contract. It mirrors deploy/.env.example (the
# authoritative PROD contract) with three categories of change:
#
#   1. DEV-ONLY isolation vars (COMPOSE_PROJECT_NAME / INNER_NGINX_PORT /
#      INNER_NGINX_CONF) — these make a SECOND stack coexist with prod on one box.
#   2. DEV domains (dev.ai-imex.com / dev-admin / dev-api).
#   3. A SEPARATE Telegram bot + userbot session (prod's bot/session MUST NOT be
#      reused — one webhook per bot, one live process per MTProto session).
#
# Copy this to the DEV REPO ROOT as `.env` and `chmod 600` it (repo-root .env is
# the convention the compose stack + CI deploy job both read — verified: both
# `env_file: ../.env` and `--env-file .env` resolve to <repo>/.env):
#     cp deploy/env.dev-server.example .env
#     chmod 600 .env
# Then fill every [SECRET]. Secrets have NO default — a missing one fails fast at
# `api` startup (pydantic Settings). `.env` is gitignored; never commit the real one.
# ============================================================================

# ── DEV isolation (dev-server only; NOT present in the prod .env) ────────────
# Separate compose project → separate volumes/containers/network from prod.
COMPOSE_PROJECT_NAME=polymer-dev
# Inner nginx host port (prod = 8080). The dev host front-door forwards to this.
INNER_NGINX_PORT=8081
# Inner nginx config with the dev-* server_names (prod = nginx.behind-proxy.conf).
INNER_NGINX_CONF=nginx.dev-server.behind-proxy.conf

# ── Database ─────────────────────────────────────────────────────────────────
# Regenerate — this is a brand-new, dev-only database. Keep DATABASE_URL in sync
# (compose injects it from POSTGRES_PASSWORD, but Settings also reads .env).
POSTGRES_PASSWORD=[SECRET: generate a fresh dev password]
DATABASE_URL=postgresql+psycopg://pi_user:[SECRET: same POSTGRES_PASSWORD]@postgres:5432/polymer_intelligence

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Anthropic / LLM ──────────────────────────────────────────────────────────
# Reuse the prod key (same billing account) OR use a separate dev key. Keep the
# dev daily budget LOW so test traffic can't drain the prod token allowance.
ANTHROPIC_API_KEY=[SECRET: Anthropic API key]
LLM_DAILY_TOKEN_LIMIT=100000
LLM_EXTRACT_MODEL=claude-haiku-4-5
LLM_REPORT_MODEL=claude-sonnet-4-5
LLM_PROMPT_VERSION=v1
UZEX_LLM_FALLBACK_ENABLED=false
REQUEST_AI_ANALYSIS_ENABLED=true
REQUEST_AI_ANALYSIS_MODEL=claude-haiku-4-5
REQUEST_AI_ANALYSIS_PROMPT_VERSION=v1
REQUEST_AI_TOKEN_ESTIMATE=1500
# Telegram group id that receives new-request notifications. Use a DEV group (or
# leave blank to disable) so dev traffic never pings the prod team chat.
REQUEST_NOTIFY_CHAT_ID=

# ── Telegram bot (DEV bot — SEPARATE from prod) ──────────────────────────────
# Create a second bot in @BotFather for dev. A bot can hold only ONE webhook, so
# dev MUST use its own token — reusing prod's would steal prod's webhook.
BOT_TOKEN=[SECRET: DEV BotFather token]
WEBHOOK_SECRET=[SECRET: fresh random string for the dev webhook path/header]
# Dev bot @handle without the leading @, for the browser Login Widget. Also run
# @BotFather /setdomain → dev.ai-imex.com for this bot.
BOT_USERNAME=[dev bot username, e.g. imex_ai_dev_bot]
CLIENT_SESSION_TTL_SECONDS=2592000

# ── Telegram userbot (DEV session — SEPARATE account strongly recommended) ───
# TG_API_ID/HASH from https://my.telegram.org. Generate TG_SESSION_STRING once
# via userbot/session.py. Use a DIFFERENT Telegram ACCOUNT than prod: running the
# same session in two live userbots triggers AUTH_KEY_DUPLICATED and invalidates it.
TG_API_ID=[SECRET: dev userbot api id]
TG_API_HASH=[SECRET: dev userbot api hash]
TG_SESSION_STRING=[SECRET: dev StringSession — separate account]
USERBOT_CHANNEL_REREAD_SECONDS=600
USERBOT_HEARTBEAT_SECONDS=60

# ── Auth ─────────────────────────────────────────────────────────────────────
# Regenerate — no dev sessions to preserve. Must be >= 32 chars.
JWT_SECRET=[SECRET: fresh >=32-char random string]

# ── Seeding ──────────────────────────────────────────────────────────────────
# REQUIRED. `seed_staff` refuses to create the bootstrap administrator from the
# public literal in seed/data/staff_users.json whenever APP_ENV is not
# "development" — and APP_ENV is pinned to "production" on this stand (see the
# note at the bottom of this file). Without it the seeder raises, the api's
# pre-start `&&` chain aborts, and uvicorn never starts: a missing variable here
# reads as a dead API, not as a seeding problem.
# Not a `Settings` field — the NAME comes from the `password_env` key of each
# record in staff_users.json, so it is read straight off os.environ.
SEED_ADMIN_PASSWORD=[SECRET: dashboard admin password for admin@polymer.uz]

# ── CORS ─────────────────────────────────────────────────────────────────────
# Same-origin in prod/dev (nginx proxies /api), so this is mostly belt-and-braces.
# List the dev origins explicitly; never "*".
CORS_ALLOWED_ORIGINS=https://dev-admin.ai-imex.com,https://dev.ai-imex.com

# ── S3 / MinIO file storage ──────────────────────────────────────────────────
# Regenerate — brand-new dev MinIO; the bucket is auto-created by minio-init.
S3_ENDPOINT=http://minio:9000
# The PUBLIC host presigned download links are signed against. Without it every
# document link names S3_ENDPOINT — `http://minio:9000`, which resolves only
# inside the docker network — so no client outside the cluster can open a
# verification document, a contract PDF, a deal attachment or a lab letter.
# Must be the API vhost and must carry NO path (nginx serves the bucket at
# `location /polymer-files/` on that block); the signature covers both the host
# and the path, so neither can be rewritten after signing.
S3_PUBLIC_ENDPOINT=https://dev-api.ai-imex.com
S3_ACCESS_KEY=[SECRET: fresh dev MinIO access key]
S3_SECRET_KEY=[SECRET: fresh dev MinIO secret key]
S3_BUCKET=polymer-files

# ── Rate limits ──────────────────────────────────────────────────────────────
# Master switch for all thirteen portal abuse buckets. Leave EMPTY/true unless a
# full regression run is in progress: the caps are real (registration 5/hour per
# IP; company creation 5/day per account; tender creation 10/day per company,
# both resetting at UTC midnight = 05:00 Tashkent) and a 100%-coverage pass
# exhausts them. `Settings` refuses false when DEBUG=false, so this cannot be
# copied into a production .env and take effect.
RATE_LIMIT_ENABLED=true

# ── Telegram Web App / public URLs (DEV domains) ─────────────────────────────
# These drive the /start WebApp button, chat menu button, status-push deep links,
# and the DEV bot's webhook registration. Leave BLANK on first bring-up if you
# want to validate the stack before touching Telegram; set them, then restart the
# api + start the userbot, to go live (mirrors the prod cutover order).
PUBLIC_WEBAPP_URL=https://dev.ai-imex.com
PUBLIC_API_URL=https://dev-api.ai-imex.com
# Dev news channel (optional). Blank → channel publishing is a no-op in dev.
NEWS_CHANNEL_ID=
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# ── Ingest HTTP tunables (safe defaults; override per-env if needed) ─────────
INGEST_HTTP_TIMEOUT_SECONDS=30
INGEST_HTTP_RETRIES=3
INGEST_USER_AGENT=PolymerIntelligence/1.0 (+contact@polymer.example)
INGEST_PER_HOST_DELAY_SECONDS=2.0

# ── Timezone / display ───────────────────────────────────────────────────────
TZ_DISPLAY=Asia/Tashkent

# ── Observability ────────────────────────────────────────────────────────────
# Use a SEPARATE Sentry project/env for dev (or leave blank) so dev errors don't
# pollute the prod issue stream.
SENTRY_DSN=

# ── Runtime ──────────────────────────────────────────────────────────────────
# api command already runs migrate+seed as pre-start steps; leave this false.
RUN_MIGRATIONS_ON_STARTUP=false
# DEV convenience: expose /docs, /redoc, /openapi.json. Keep FALSE in prod.
DEBUG=true

# NOTE: APP_ENV=production is set on the api service in docker-compose.yml (not
# here) and SHOULD stay production for dev too — the dev stack is served over TLS
# by the host front-door, so the Secure refresh-cookie flag must remain on.
