# ============================================================================
# Polymer Intelligence — Environment Contract
# ============================================================================
#
# Copy this file to ../.env (ONE LEVEL ABOVE the repo root, or place it at the
# repo root next to docker-compose). The real .env is NEVER committed — it is
# listed in .gitignore. This file contains placeholder values only.
#
# All secrets marked [SECRET] must be supplied before `docker compose up`.
# Every variable the app reads (backend/app/core/config.py) is listed here.
# Variables WITHOUT [SECRET] have safe code defaults — shown for reference; you
# only need to override them per environment.
#
# [panel: X] marks a variable that is ALSO editable at /admin/settings/X while
# the app is running. The value here stays the default and the panel shows both
# side by side, so a line you never touch means exactly what it says. A variable
# without the marker is env-only on purpose — LLM_PROMPT_VERSION, for instance,
# names a file that has to be in the image, which makes it a property of the
# deploy rather than something an operator can pick.
# ============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pi_user:change_me@postgres:5432/polymer_intelligence
# SQLAlchemy pool, PER PROCESS. The ceiling that matters is
#   (API_WORKERS + CELERY_CONCURRENCY) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# against POSTGRES_MAX_CONNECTIONS below. At these defaults: 8 x 15 = 120 of 200,
# leaving headroom for beat, the userbot and psql. Exhaustion shows up as
# `FATAL: sorry, too many clients already` under load, not as gradual slowness —
# so raise the worker counts and this together, never one alone.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Process counts / concurrency ─────────────────────────────────────────────
# uvicorn worker processes for the api. Almost every path operation is sync `def`
# and runs in a threadpool, so a single process is bounded by one GIL; this is the
# knob that uses the other cores. Roughly one per core is a sane starting point.
API_WORKERS=4
# Celery worker processes. PINNED because Celery's own default is one per core,
# which silently moves the connection ceiling when the host changes size.
CELERY_CONCURRENCY=4
# Postgres `max_connections`. The stock value is 100, which the api alone can
# reach at the defaults above.
POSTGRES_MAX_CONNECTIONS=200

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM providers ────────────────────────────────────────────────────────────
# Anthropic is the required one — it is what the platform ships running, and a
# deployment with no LLM key at all should fail at startup rather than classify
# every article badly and never say why.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME       # [panel: ai] [SECRET]
LLM_DAILY_TOKEN_LIMIT=500000
LLM_PROMPT_VERSION=v1                        # Prompt version pin; stored in parse_runs for replay
# Daily/evening digest prompt (parsing/prompts/report_vN.md) — versioned apart
# from the extractor prompt so the two can evolve independently.
REPORT_PROMPT_VERSION=v6
# When true, UZEX rows the rule-based dictionary does NOT recognize are routed
# through the LLM extractor (budget-gated) instead of being marked irrelevant.
# Off by default: it spends Anthropic tokens per unrecognized row.
UZEX_LLM_FALLBACK_ENABLED=false

# ── Request AI analysis (Phase 5 — buyer-request match/demand/recommendation) ─
# When true, a submitted buyer request is analysed by the LLM (match_score,
# demand_level, recommendation) and stamped into requests.ai. Budget-gated.
REQUEST_AI_ANALYSIS_ENABLED=true
REQUEST_AI_ANALYSIS_MODEL=claude-haiku-4-5
REQUEST_AI_ANALYSIS_PROMPT_VERSION=v1
REQUEST_AI_TOKEN_ESTIMATE=1500             # Per-request token reservation for the budget guard

# ── Telegram bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJ   # [SECRET] from @BotFather
WEBHOOK_SECRET=replace_with_random_32_char # [SECRET] random string >=32 chars
# Public bot @handle WITHOUT the leading @ (e.g. imex_ai_bot). Enables browser login
# via the Telegram Login Widget on the IMEX AI landing. REQUIRED for browser auth;
# you MUST also run BotFather /setdomain for your public domain or the widget won't
# render/authenticate. Leave empty to keep the webapp Mini-App-only.
BOT_USERNAME=
# Lifetime (seconds) of the browser client-session cookie issued after Login Widget
# auth. Default 30 days.
CLIENT_SESSION_TTL_SECONDS=2592000

# ── Telegram userbot (customer-provided) ─────────────────────────────────────
TG_API_ID=12345678                         # [SECRET] from my.telegram.org
TG_API_HASH=abcdef1234567890abcdef1234     # [SECRET] from my.telegram.org
TG_SESSION_STRING=                         # [SECRET] generated once via the interactive StringSession login
                                           #   flow in userbot/session.py; NEVER commit this value.
                                           #   Set via: python userbot/session.py (interactive)
USERBOT_CHANNEL_REREAD_SECONDS=600         # Re-read enabled channel list interval (seconds); default 10 min
USERBOT_HEARTBEAT_SECONDS=60               # Redis heartbeat write interval (seconds); default 60 s

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_char_hex # [SECRET] random string >=64 chars

# ── Company verification & portal (R1) ────────────────────────────────────────
# Fernet key that encrypts company bank account numbers (R1) + PINFL (R3) at the
# app layer. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VERIFICATION_ENC_KEY=replace_with_fernet_key_44_urlsafe_b64_chars   # [SECRET] >=32 chars
# SMS provider for phone-OTP portal auth. "console" (default) logs the code at INFO
# (dev/CI); "eskiz" sends real SMS via Eskiz.uz and REQUIRES the two creds below.
SMS_PROVIDER=console
ESKIZ_EMAIL=                               # [SECRET] required only when SMS_PROVIDER=eskiz
ESKIZ_PASSWORD=                            # [SECRET] required only when SMS_PROVIDER=eskiz
# OTP tunables (Redis-backed). Defaults are the security baseline (A1).
# DEV/DEMO ONLY — a fixed OTP so a demo login does not need the code fished out
# of a worker log. Honoured ONLY when DEBUG=true AND SMS_PROVIDER=console; a
# non-empty value with a real SMS provider fails at startup. A predictable OTP
# means anyone who knows a phone number can sign in as its owner, so this MUST
# stay empty in production. Empty, or exactly 6 digits.
OTP_DEV_CODE=
OTP_TTL_SECONDS=300                        # code lifetime
OTP_RESEND_COOLDOWN_SECONDS=60             # min gap between sends to one phone
OTP_MAX_SENDS_PER_DAY=5                    # per phone AND per IP
OTP_MAX_VERIFY_ATTEMPTS=5                  # per code before lockout
# Portal refresh-cookie lifetime (days); short access JWT (aud=portal) rides on top.
PORTAL_SESSION_TTL_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for credentialed requests. NEVER "*".
# In prod/dev nginx serves same-origin (dashboard + /api on one host), so this is
# mostly belt-and-braces; list the public frontends explicitly, e.g.:
#   CORS_ALLOWED_ORIGINS=https://admin.ai-imex.com,https://ai-imex.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── S3 / MinIO file storage ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_access_key             # [SECRET]
S3_SECRET_KEY=minio_secret_key             # [SECRET]
S3_BUCKET=polymer-files

# ── Telegram Web App / public URLs ────────────────────────────────────────────
# Externally reachable Web App base URL (e.g. https://ai-imex.com). Drives the
# /start WebApp button, the chat menu button, and status-push deep links. Leave
# BLANK to skip Telegram webhook registration on api startup (useful when
# pre-staging a stack). Set it to go live.
PUBLIC_WEBAPP_URL=
# Externally reachable API base URL (e.g. https://api.ai-imex.com) — where the
# Telegram webhook registers. Falls back to PUBLIC_WEBAPP_URL when empty
# (single-domain deployments).
PUBLIC_API_URL=
# TTL (seconds) for Telegram Web App initData HMAC verification. initData older
# than this is rejected as potentially replayed. Default 24 h.
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
# ── Timezone / display ────────────────────────────────────────────────────────
TZ_DISPLAY=Asia/Tashkent

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                                # Optional — leave blank to disable

# ── Runtime ───────────────────────────────────────────────────────────────────
# Deployment environment. `production` is the only value that changes behaviour:
# it sets `Secure` on the staff refresh cookie, so the session cookie is refused
# over plain HTTP. A typo (`prod`, `Production`) used to mean "not production"
# silently; it now fails at startup. One of: development | staging | production.
APP_ENV=development
# When true, the FastAPI lifespan runs `alembic upgrade head` on startup. Compose
# runs migrations as an explicit pre-start step instead, so this stays false there.
RUN_MIGRATIONS_ON_STARTUP=false
# When true, exposes /docs, /redoc, /openapi.json. MUST be false in production
# (the OpenAPI schema is a full attack-surface map). Set true for local dev.
DEBUG=false

# ── E-IMZO verification rails (R3) ────────────────────────────────────────────
# UNICON e-imzo-server sidecar (internal network, no published ports). All
# PKCS#7 verification is delegated there — stock crypto libraries cannot verify
# the national O'zDSt algorithms. Defaults to the compose service name.
EIMZO_SERVER_URL=http://eimzo-server:8080
# Lifetime of a one-time signing challenge in Redis (single-use).
EIMZO_CHALLENGE_TTL_SECONDS=300
# DEV/DEMO ONLY. When true the gateway does NOT call the sidecar; it verifies a
# synthetic PKCS#7 from the stub CAPIWS bridge, so onboarding is exercisable
# without the UNICON artifact. MUST stay false in production.
EIMZO_STUB=false

# ── Escrow provider callbacks (R6 / P7.b) ─────────────────────────────────────
# Shared secret the partner bank sends in `X-Escrow-Token` on every callback to
# POST /api/v1/webhooks/escrow/{provider}. While empty the route answers 404, so
# an unconfigured deployment does not advertise the endpoint. REQUIRED (fails at
# startup) when ESCROW_MODE=live — a live rail that cannot hear the bank's reply
# would leave every payment pending forever.
ESCROW_WEBHOOK_SECRET=                     # [SECRET] required when ESCROW_MODE=live
# ── Upstream provider hosts ───────────────────────────────────────────────────
# Base URLs of the third parties the built-in code adapters talk to. Defaults are
# today's production hosts — set one only to point at a mirror, a sandbox, or a
# local recording. (No-code adapters keep their URLs as rows in `sources`.)
UZEX_BASE_URL=https://uzex.uz
XARID_BASE_URL=https://xarid-api-auction.uzex.uz
CBU_RATES_URL=https://cbu.uz/ru/arkhiv-kursov-valyut/json/
ESKIZ_BASE_URL=https://notify.eskiz.uz

# ══════════════════════════════════════════════════════════════════════════════
# RUNTIME FEATURE SWITCHES — not listed here
# ══════════════════════════════════════════════════════════════════════════════
# 31 switches that turn features and external rails on and off used to be
# enumerated below. They are edited at /admin/settings instead, across the pages
# ai, compliance, deals, didox, ingest, news, notifications, sourcing.
#
# Their DEFAULTS live on `Settings` (backend/app/core/config.py), which is also
# where their type, bounds and `Literal` sets are declared — so the default and
# the validation are one thing rather than a value here and a rule there.
#
# They are still ordinary environment variables. Setting one in this file or in
# compose overrides the code default exactly as before, and the panel shows the
# result beside it with the env var named. To list the names and defaults without
# opening the panel:
#
#     GET /admin/settings
#     cd backend && uv run python -c "from app.services.settings_service import SPECS; \
#         print('\n'.join(f'{s.env_var} [{s.group}]' for s in SPECS.values()))"
#
# The CREDENTIALS among them are set in the panel too, where they are stored
# Fernet-encrypted rather than in plaintext here. The one exception is
# ANTHROPIC_API_KEY, listed above: it is required at startup and `Settings`
# validates before anything reads a database, so no override can precede it — a
# deployment that copied this file without it would not boot, with nothing here
# to say why.
#
# Why the panel shows both values rather than just the live one: the arrangement
# this replaced stored a value next to a default written as a Python literal, so a
# fresh database ran every rail on something nobody had chosen or could see. On
# 31.08.2026 that made a healthy, fully-credentialed Didox integration answer
# `503 registry_not_configured` on every lookup, and finding out why meant reading
# a service module and then querying Postgres. An override is displayed AS an
# override, against the default it replaces.
