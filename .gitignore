# Secrets & runtime credentials (dev-spec §5, §4.3)
.env
.env.*
!.env.example
*.session
*.session-journal

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
celerybeat-schedule

# Node / frontend
node_modules/
.next/
dist/
build/
*.log
tsconfig.tsbuildinfo

# OS / editor
.DS_Store
.idea/
# Local Claude Code config stays out; shared skills are part of the repo.
# (must be `.claude/*` + a negation — git will not descend into an ignored dir)
.claude/*
!.claude/skills/

# Planning (GSD tooling — not part of the shipped codebase)
.planning/config.json

# Playwright MCP scratch output (page snapshots, console logs, screenshots)
.playwright-mcp/

# Ad-hoc Didox support artefacts — they carry the LIVE partner token.
didox-offer-create-request.txt
didox-offer-create.sh
didox-newoffer-base64.txt
didox-offer-create-body.json

# Настоящие подписанные договоры контрагентов — справочный материал, не код.
docs/deals_documents/

# Кадры онбординг-доски и собранные носители: 87 МБ снимков живого стенда.
# Описание доски (board-model.json) и генератор лежат в .planning/onboarding-board/,
# сами носители пересобираются из них: node .planning/onboarding-board/build.mjs
# (dist/ уже покрыт общим правилом выше).
.tmp-onboarding/
